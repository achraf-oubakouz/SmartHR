@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SMART-HR</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <style>
        /* Enhanced Navbar Styling */
        .navbar-nav {
            gap: 0.5rem;
        }
        
        .nav-item .nav-link {
            padding: 0.5rem 1rem !important;
            border-radius: 0.375rem;
            transition: all 0.2s ease;
        }
        
        .nav-item .nav-link:hover {
            background-color: rgba(255, 255, 255, 0.1);
        }
        
        /* Admin Dropdown Styling */
        .dropdown-menu {
            border-radius: 0.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
            border: none;
            padding: 0.5rem;
            margin-top: 0.5rem;
            min-width: 200px;
        }
        
        .dropdown-item {
            padding: 0.5rem 1rem;
            border-radius: 0.375rem;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .dropdown-item:hover {
            background-color: #f8f9fa;
            transform: translateX(5px);
        }
        
        .dropdown-item i {
            width: 20px;
            text-align: center;
        }
        
        .dropdown-divider {
            margin: 0.5rem 0;
        }
        
        /* User Menu Dropdown */
        #userDropdown {
            color: #fff !important;
            padding: 0.5rem 1rem;
            border-radius: 0.375rem;
            transition: all 0.2s ease;
        }
        
        #userDropdown:hover {
            background-color: rgba(255, 255, 255, 0.1);
        }
        
        #userDropdown i {
            font-size: 1.5rem;
        }
        
        .dropdown-menu-end {
            right: 0;
            left: auto;
        }
        
        .dropdown-item.text-danger:hover {
            background-color: #fee;
            color: #dc3545 !important;
        }
        
        /* Navbar spacing improvements */
        .nav-user-menu {
            margin-left: 1rem;
        }
        
        .navbar-nav .nav-item {
            margin: 0 0.25rem;
        }
        
        /* Make dropdown toggle icon smaller */
        .dropdown-toggle::after {
            font-size: 0.75rem;
            vertical-align: middle;
            margin-left: 0.4rem;
        }
    </style>
</head>
<body>
    <!-- ═══════════════════════════════════════════════════════════
         NAVBAR (Shared across all pages)
    ═══════════════════════════════════════════════════════════ -->
    <header class="site-header">
        <div class="container">
            <nav class="navbar navbar-expand-lg">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/images/smart-hr-logo.png" alt="SmartHR" class="brand-logo">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-center" id="mainNav">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Accueil</a>
                        </li>
                        @if (Context.Session.GetString("UserRole") == "Admin")
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Admin
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                    <li><a class="dropdown-item" asp-controller="Admins" asp-action="Dashboard"><i class="bi bi-house-door"></i> Dashboard</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admins" asp-action="Users"><i class="bi bi-people"></i> Utilisateurs</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Admins" asp-action="Settings"><i class="bi bi-gear"></i> Paramètres</a></li>
                                </ul>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="DemandeConges" asp-action="MesDemandes">Congés</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Calendriers" asp-action="Index">Calendrier</a>
                        </li>
                        @{
                            var role = Context.Session.GetString("UserRole");
                        }
                        @if (role == "Admin" || role == "Manager" || role == "RH")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Rapports" asp-action="Index">Rapports</a>
                            </li>
                        }
                    </ul>
                </div>
                @if (Context.Session.GetInt32("UserId") != null)
                {
                    <div class="nav-user-menu d-none d-lg-flex align-items-center">
                        <div class="dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-2"></i>
                                <span>@Context.Session.GetString("UserName")</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="Profile"><i class="bi bi-person"></i> Mon Profil</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" asp-controller="Home" asp-action="Logout"><i class="bi bi-box-arrow-right"></i> Déconnexion</a></li>
                            </ul>
                        </div>
                    </div>
                }
                else
                {
                    <a asp-controller="Home" asp-action="Login" class="btn btn-accent d-none d-lg-inline-flex">Se connecter</a>
                }
            </nav>
        </div>
    </header>

    @RenderBody()
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
