@model IEnumerable<SMART_HR.Models.CompanyNewsItem>
@{
    ViewData["Title"] = "Accueil";
}

<div class="home-hero-shell text-center">

    <h1 class="home-hero-title fw-bold mb-3">
        Bienvenue dans SmartHR – Gestion des congés et présence
    </h1>

    <p class="home-hero-subtitle text-muted mb-4">
        Suivez vos demandes de congé, votre calendrier, et vos documents RH en un seul endroit.
    </p>

    <div class="d-flex flex-wrap justify-content-center gap-2 mb-5">
        <a class="btn btn-primary btn-lg btn-pill" asp-controller="Home" asp-action="Login">
            Accéder à votre compte
        </a>
        <a class="btn btn-outline-secondary btn-lg btn-pill" asp-controller="Calendriers" asp-action="Index">
            Voir le calendrier RH
        </a>
    </div>
</div>

<partial name="~/Views/Shared/_CompanyNews.cshtml" model="Model" />
