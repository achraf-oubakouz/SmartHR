@{
    ViewData["Title"] = "Accueil";
}

<!-- ═══════════════════════════════════════════════════════════
     HERO SECTION
═══════════════════════════════════════════════════════════ -->
<section class="hero">
    <div class="hero-content">
        <h1 class="hero-title">Gérez Vos Ressources Humaines</h1>
        <p class="hero-subtitle">
            Que ce soit pour les demandes de congés, le suivi de présence ou la gestion documentaire, 
            SmartHR vous accompagne pour une gestion RH moderne, efficace et sereine.
        </p>
        <div class="hero-buttons">
            <a asp-controller="Home" asp-action="Login" class="btn-hero-primary">
                Accéder à mon espace
            </a>
            <a href="#fonctionnalites" class="btn-hero-secondary">
                En savoir plus
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M12 5v14M19 12l-7 7-7-7"/>
                </svg>
            </a>
        </div>
    </div>
    <div class="hero-scroll-indicator">
        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M12 5v14M19 12l-7 7-7-7"/>
        </svg>
    </div>
    <div class="hero-diagonal"></div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     ABOUT SECTION
═══════════════════════════════════════════════════════════ -->
<section class="about-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <div class="about-image-wrap">
                    <img src="https://images.unsplash.com/photo-1551434678-e076c223a692?auto=format&fit=crop&w=600&q=80" alt="Équipe de travail" class="about-img">
                    <div class="about-counter">
                        <span class="counter-number">100%</span>
                        <span class="counter-label">Dématérialisé</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="about-content">
                    <p class="section-eyebrow">À propos de SmartHR</p>
                    <h2 class="section-title">La gestion RH simplifiée pour votre entreprise</h2>
                    <p class="section-desc">SmartHR est une solution complète pour gérer les congés, la présence et les documents de vos collaborateurs. Fini les formulaires papier et les échanges d'emails interminables. Tout est centralisé, automatisé et accessible en quelques clics.</p>
                    <div class="feature-boxes">
                        <div class="feature-box">
                            <div class="feature-icon">
                                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                            </div>
                            <h4>Validation rapide</h4>
                            <p>Les managers reçoivent et valident les demandes instantanément.</p>
                        </div>
                        <div class="feature-box">
                            <div class="feature-icon">
                                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01"/></svg>
                            </div>
                            <h4>Pour tous</h4>
                            <p>Interface simple adaptée à tous les collaborateurs.</p>
                        </div>
                    </div>
                    <a asp-controller="Calendriers" asp-action="Index" class="btn btn-accent">Voir le calendrier</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     WHY CHOOSE US
═══════════════════════════════════════════════════════════ -->
<section class="why-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <p class="section-eyebrow light">Pourquoi SmartHR</p>
                <h2 class="section-title light">Une solution adaptée à vos besoins RH</h2>
                <p class="section-desc light">Notre plateforme s'adapte à la taille et aux processus de votre entreprise. Que vous soyez une PME ou une grande entreprise, SmartHR simplifie le quotidien de vos équipes RH et de vos collaborateurs.</p>
                <div class="row mt-4">
                    <div class="col-md-6">
                        <h5 class="why-feature-title">Gestion des congés</h5>
                        <p class="why-feature-desc">Demandes, validations et suivi des soldes en temps réel. Plus de paperasse, tout est automatisé.</p>
                    </div>
                    <div class="col-md-6">
                        <h5 class="why-feature-title">Suivi de présence</h5>
                        <p class="why-feature-desc">Visualisez les présences et absences de votre équipe sur un calendrier partagé.</p>
                    </div>
                </div>
                <div class="why-cta mt-4">
                    <a asp-controller="DemandeConges" asp-action="Index" class="btn btn-light-outline">Mes demandes</a>
                    <a asp-controller="Documents" asp-action="Index" class="btn btn-link-light">Mes documents</a>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="why-images">
                    <div class="why-img-main">
                        <img src="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?auto=format&fit=crop&w=500&q=80" alt="Équipe au travail">
                    </div>
                    <div class="why-stats">
                        <div class="stat-card">
                            <div class="stat-circle" style="--percent: 95;">
                                <span>95%</span>
                            </div>
                            <p class="stat-label">Satisfaction</p>
                            <p class="stat-desc">Taux de satisfaction des utilisateurs.</p>
                        </div>
                        <div class="stat-card">
                            <div class="stat-circle" style="--percent: 80;">
                                <span>80%</span>
                            </div>
                            <p class="stat-label">Temps gagné</p>
                            <p class="stat-desc">Réduction du temps de traitement.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

