@{
    ViewData["Title"] = "Connexion";
}

<div class="home-hero-shell text-center">
    <h1 class="home-hero-title fw-bold mb-3">
        Connexion à SmartHR
    </h1>
    <p class="home-hero-subtitle text-muted mb-4">
        Entrez vos identifiants pour accéder à votre tableau de bord SmartHR.
    </p>

    <div class="d-flex justify-content-center">
        <div class="card shadow-sm p-4" style="max-width: 420px; width: 100%; border-radius: 20px;">
            <form method="post">
                <div class="mb-3 text-start">
                    <label class="form-label" for="email">Adresse e-mail</label>
                    <input type="email" class="form-control" id="email" name="email" placeholder="vous@entreprise.com" />
                </div>
                <div class="mb-3 text-start">
                    <label class="form-label" for="password">Mot de passe</label>
                    <input type="password" class="form-control" id="password" name="password" placeholder="••••••••" />
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="rememberMe" />
                        <label class="form-check-label small" for="rememberMe">Se souvenir de moi</label>
                    </div>
                    <a href="#" class="small text-muted text-decoration-none">Mot de passe oublié ?</a>
                </div>
                <button type="submit" class="btn btn-primary w-100 btn-pill">
                    Se connecter
                </button>
            </form>
        </div>
    </div>
</div>


