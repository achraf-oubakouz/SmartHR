@using SmartHR.Controllers
@{
    ViewData["Title"] = "Mes Documents";
    var isLoggedIn = ViewBag.IsLoggedIn as bool? ?? false;
    var documents = ViewBag.Documents as List<DocumentInfo>;
    var stats = ViewBag.Stats as DocumentStats;
    var employe = ViewBag.Employe as SmartHR.Models.Employe;
}

<style>
    .documents-header {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
        color: white;
        padding: 2rem;
        border-radius: 1rem;
        margin-bottom: 2rem;
    }
    .documents-header h1 {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }
    .documents-header p {
        opacity: 0.8;
        margin-bottom: 0;
    }
    .stat-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }
    .stat-card {
        background: white;
        border-radius: 1rem;
        padding: 1.25rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        text-align: center;
    }
    .stat-card .stat-icon {
        font-size: 2rem;
        margin-bottom: 0.5rem;
    }
    .stat-card .stat-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1a1a2e;
    }
    .stat-card .stat-label {
        color: #64748b;
        font-size: 0.875rem;
    }
    .documents-section {
        background: white;
        border-radius: 1rem;
        padding: 1.5rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        margin-bottom: 1.5rem;
    }
    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #e2e8f0;
    }
    .section-header h3 {
        font-size: 1.25rem;
        font-weight: 600;
        color: #1a1a2e;
        margin: 0;
    }
    .filter-tabs {
        display: flex;
        gap: 0.5rem;
    }
    .filter-tab {
        padding: 0.5rem 1rem;
        border: 1px solid #e2e8f0;
        background: white;
        color: #64748b;
        border-radius: 0.5rem;
        cursor: pointer;
        font-size: 0.875rem;
        transition: all 0.2s;
    }
    .filter-tab:hover, .filter-tab.active {
        background: #1a1a2e;
        color: white;
        border-color: #1a1a2e;
    }
    .documents-table {
        width: 100%;
    }
    .documents-table th {
        text-align: left;
        padding: 0.75rem 1rem;
        color: #64748b;
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 1px solid #e2e8f0;
    }
    .documents-table td {
        padding: 1rem;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
    }
    .documents-table tr:hover td {
        background: #f8fafc;
    }
    .doc-name {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    .doc-icon {
        width: 40px;
        height: 40px;
        border-radius: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        background: #f1f5f9;
    }
    .doc-info h5 {
        font-weight: 600;
        color: #1a1a2e;
        margin: 0 0 0.25rem 0;
        font-size: 0.9rem;
    }
    .doc-info span {
        color: #64748b;
        font-size: 0.75rem;
    }
    .doc-badge {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 500;
    }
    .doc-badge.bulletin { background: #dcfce7; color: #16a34a; }
    .doc-badge.contrat { background: #dbeafe; color: #2563eb; }
    .doc-badge.attestation { background: #fef3c7; color: #d97706; }
    .doc-badge.solde { background: #e9d5ff; color: #9333ea; }
    .doc-badge.avenant { background: #fee2e2; color: #dc2626; }
    .doc-badge.new {
        background: #ef4444;
        color: white;
        font-size: 0.625rem;
        padding: 0.125rem 0.5rem;
        margin-left: 0.5rem;
    }
    .btn-download {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.375rem 0.75rem;
        background: #1a1a2e;
        color: white;
        border-radius: 0.375rem;
        text-decoration: none;
        font-size: 0.75rem;
        transition: background 0.2s;
    }
    .btn-download:hover {
        background: #16213e;
        color: white;
    }
    .btn-request {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        background: #1a1a2e;
        color: white;
        border-radius: 0.5rem;
        text-decoration: none;
        font-weight: 500;
    }
    .btn-request:hover {
        background: #16213e;
        color: white;
    }
    .login-prompt {
        background: white;
        border-radius: 1rem;
        padding: 4rem 2rem;
        text-align: center;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }
    .login-prompt .icon {
        font-size: 4rem;
        margin-bottom: 1rem;
    }
    .login-prompt h3 {
        color: #1a1a2e;
        margin-bottom: 0.5rem;
    }
    .login-prompt p {
        color: #64748b;
        margin-bottom: 1.5rem;
    }
    .btn-login {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 2rem;
        background: #1a1a2e;
        color: white;
        border-radius: 0.5rem;
        text-decoration: none;
        font-weight: 500;
    }
    .btn-login:hover {
        background: #16213e;
        color: white;
    }
    .alert-custom {
        padding: 1rem 1.5rem;
        border-radius: 0.75rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    .alert-custom.success {
        background: #dcfce7;
        color: #16a34a;
    }
    .alert-custom.info {
        background: #dbeafe;
        color: #2563eb;
    }
</style>

<div class="container py-4">
    <div class="documents-header">
        <h1>📄 Mes Documents</h1>
        <p>Accédez à tous vos documents RH : bulletins de paie, contrats, attestations</p>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert-custom @(TempData["MessageType"]?.ToString() ?? "info")">
            <span>@(TempData["MessageType"]?.ToString() == "success" ? "✅" : "ℹ️")</span>
            @TempData["Message"]
        </div>
    }

    @if (isLoggedIn)
    {
        <!-- Statistiques -->
        <div class="stat-cards">
            <div class="stat-card">
                <div class="stat-icon">📁</div>
                <div class="stat-value">@(stats?.TotalDocuments ?? 0)</div>
                <div class="stat-label">Documents disponibles</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">🆕</div>
                <div class="stat-value">@(stats?.DocumentsRecents ?? 0)</div>
                <div class="stat-label">Ajoutés ce mois</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">📬</div>
                <div class="stat-value">@(stats?.DocumentsNonLus ?? 0)</div>
                <div class="stat-label">Non consultés</div>
            </div>
        </div>

        <!-- Liste des documents -->
        <div class="documents-section">
            <div class="section-header">
                <h3>📋 Tous mes documents</h3>
                <div class="filter-tabs">
                    <button class="filter-tab active" onclick="filterDocs('all')">Tous</button>
                    <button class="filter-tab" onclick="filterDocs('bulletin')">Bulletins</button>
                    <button class="filter-tab" onclick="filterDocs('contrat')">Contrats</button>
                    <button class="filter-tab" onclick="filterDocs('attestation')">Attestations</button>
                </div>
            </div>

            <table class="documents-table">
                <thead>
                    <tr>
                        <th>Document</th>
                        <th>Type</th>
                        <th>Date</th>
                        <th>Taille</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (documents != null && documents.Any())
                    {
                        @foreach (var doc in documents)
                        {
                            var badgeClass = doc.Type.ToLower() switch
                            {
                                "bulletin de paie" => "bulletin",
                                "contrat" => "contrat",
                                "avenant" => "avenant",
                                "attestation" => "attestation",
                                "solde congés" => "solde",
                                _ => "bulletin"
                            };
                            
                            <tr data-type="@badgeClass">
                                <td>
                                    <div class="doc-name">
                                        <div class="doc-icon">@doc.Icone</div>
                                        <div class="doc-info">
                                            <h5>
                                                @doc.Nom
                                                @if (!doc.EstLu)
                                                {
                                                    <span class="doc-badge new">Nouveau</span>
                                                }
                                            </h5>
                                            <span>@doc.Format</span>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="doc-badge @badgeClass">@doc.Type</span></td>
                                <td>@doc.DateCreation.ToString("dd/MM/yyyy")</td>
                                <td>@doc.Taille</td>
                                <td>
                                    <a asp-action="Download" asp-route-id="@doc.Id" asp-route-type="@doc.Type" class="btn-download">
                                        📥 Télécharger
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                Aucun document disponible
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Demander un document -->
        <div class="documents-section">
            <div class="section-header">
                <h3>📝 Besoin d'un document ?</h3>
            </div>
            <p class="text-muted mb-3">Vous pouvez demander la génération d'une attestation ou d'un autre document au service RH.</p>
            <a asp-action="Demander" class="btn-request">
                ➕ Demander un document
            </a>
        </div>
    }
    else
    {
        <div class="login-prompt">
            <div class="icon">🔒</div>
            <h3>Connexion requise</h3>
            <p>Veuillez vous connecter pour accéder à vos documents personnels.</p>
            <a asp-controller="Home" asp-action="Login" class="btn-login">
                Se connecter
            </a>
        </div>
    }
</div>

<script>
    function filterDocs(type) {
        // Mettre à jour les onglets actifs
        document.querySelectorAll('.filter-tab').forEach(tab => tab.classList.remove('active'));
        event.target.classList.add('active');
        
        // Filtrer les lignes
        document.querySelectorAll('.documents-table tbody tr').forEach(row => {
            if (type === 'all' || row.dataset.type === type) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }
</script>
