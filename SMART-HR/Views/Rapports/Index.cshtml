@model SmartHR.ViewModels.RapportDashboardViewModel

@{
    ViewData["Title"] = "Tableau de Bord - Rapports";
}

<style>
    .dashboard-header {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
        color: white;
        padding: 2rem;
        border-radius: 1rem;
        margin-bottom: 2rem;
    }
    .dashboard-header h1 {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }
    .dashboard-header p {
        opacity: 0.8;
        margin-bottom: 1rem;
    }
    .year-selector {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }
    .year-btn {
        padding: 0.5rem 1rem;
        border: 1px solid rgba(255,255,255,0.3);
        background: transparent;
        color: white;
        border-radius: 0.5rem;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
    }
    .year-btn:hover, .year-btn.active {
        background: white;
        color: #1a1a2e;
    }
    .stat-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }
    .stat-card {
        background: white;
        border-radius: 1rem;
        padding: 1.5rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        border-left: 4px solid;
    }
    .stat-card.blue { border-left-color: #3b82f6; }
    .stat-card.green { border-left-color: #10b981; }
    .stat-card.yellow { border-left-color: #f59e0b; }
    .stat-card.red { border-left-color: #ef4444; }
    .stat-card .stat-value {
        font-size: 2rem;
        font-weight: 700;
        color: #1a1a2e;
    }
    .stat-card .stat-label {
        color: #64748b;
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }
    .report-section {
        background: white;
        border-radius: 1rem;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }
    .report-section h3 {
        font-size: 1.25rem;
        font-weight: 600;
        color: #1a1a2e;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .report-section h3 .icon {
        width: 32px;
        height: 32px;
        border-radius: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }
    .progress-bar-container {
        margin-bottom: 1rem;
    }
    .progress-label {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.25rem;
        font-size: 0.875rem;
    }
    .progress-bar {
        height: 8px;
        background: #e2e8f0;
        border-radius: 4px;
        overflow: hidden;
    }
    .progress-fill {
        height: 100%;
        border-radius: 4px;
        transition: width 0.5s ease;
    }
    .table-modern {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }
    .table-modern th {
        background: #f8fafc;
        padding: 0.75rem 1rem;
        text-align: left;
        font-weight: 600;
        color: #475569;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .table-modern td {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #e2e8f0;
        color: #334155;
    }
    .table-modern tr:hover td {
        background: #f8fafc;
    }
    .badge {
        padding: 0.25rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 500;
    }
    .badge-hausse {
        background: #dcfce7;
        color: #16a34a;
    }
    .badge-baisse {
        background: #fee2e2;
        color: #dc2626;
    }
    .badge-stable {
        background: #e0e7ff;
        color: #4f46e5;
    }
    .badge-pic {
        background: #fef3c7;
        color: #d97706;
    }
    .chart-placeholder {
        height: 200px;
        background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        border-radius: 0.5rem;
        display: flex;
        align-items: flex-end;
        justify-content: space-around;
        padding: 1rem;
        gap: 0.5rem;
    }
    .chart-bar {
        width: 100%;
        max-width: 40px;
        background: linear-gradient(180deg, #3b82f6 0%, #1d4ed8 100%);
        border-radius: 4px 4px 0 0;
        transition: height 0.5s ease;
        position: relative;
    }
    .chart-bar::after {
        content: attr(data-value);
        position: absolute;
        top: -1.5rem;
        left: 50%;
        transform: translateX(-50%);
        font-size: 0.625rem;
        color: #64748b;
        white-space: nowrap;
    }
    .chart-bar.highlight {
        background: linear-gradient(180deg, #f59e0b 0%, #d97706 100%);
    }
    
    .btn-action {
        padding: 0.75rem 1.5rem;
        border-radius: 0.5rem;
        font-weight: 500;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.2s;
    }
    .btn-primary-custom {
        background: #1a1a2e;
        color: white;
    }
    .btn-primary-custom:hover {
        background: #16213e;
        color: white;
    }
    .btn-outline-custom {
        border: 1px solid #e2e8f0;
        background: white;
        color: #334155;
    }
    .btn-outline-custom:hover {
        background: #f8fafc;
        color: #1a1a2e;
    }
    .empty-state {
        text-align: center;
        padding: 3rem;
        color: #64748b;
    }
    .empty-state svg {
        width: 64px;
        height: 64px;
        margin-bottom: 1rem;
        opacity: 0.5;
    }
</style>

<div class="container py-4">
    <!-- Header -->
    <div class="dashboard-header">
        <h1>Tableau de bord des rapports</h1>
        <p>Analysez les données RH de votre entreprise.</p>
        <div class="year-selector">
            @foreach (var annee in Model.AnneesDisponibles)
            {
                <a href="@Url.Action("Index", new { annee = annee })" 
                   class="year-btn @(annee == Model.AnneeSelectionnee ? "active" : "")">
                    @annee
                </a>
            }
        </div>
    </div>

    <!-- Statistiques globales -->
    <div class="stat-cards">
        <div class="stat-card blue">
            <div class="stat-value">@Model.TotalEmployes</div>
            <div class="stat-label">Employés Total</div>
        </div>
        <div class="stat-card green">
            <div class="stat-value">@Model.CongesApprouves</div>
            <div class="stat-label">Congés Approuvés</div>
        </div>
        <div class="stat-card yellow">
            <div class="stat-value">@Model.CongesEnAttente</div>
            <div class="stat-label">En Attente</div>
        </div>
        <div class="stat-card red">
            <div class="stat-value">@Model.TauxApprobation%</div>
            <div class="stat-label">Taux d'Approbation</div>
        </div>
    </div>

    <div class="row">
        <!-- 1. Employés par département -->
        <div class="col-lg-6">
            <div class="report-section">
                <h3>
                    <span class="icon" style="background: #dbeafe; color: #3b82f6;">
                        <i class="bi bi-people-fill"></i>
                    </span>
                    Employés par département
                </h3>
                @if (Model.EmployesParDepartement.Any())
                {
                    @foreach (var dept in Model.EmployesParDepartement)
                    {
                        <div class="progress-bar-container">
                            <div class="progress-label">
                                <span>@dept.Departement</span>
                                <span><strong>@dept.NombreEmployes</strong> (@dept.Pourcentage%)</span>
                            </div>
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: @dept.Pourcentage%; background: #3b82f6;"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <p>Aucun employé enregistré</p>
                    </div>
                }
            </div>
        </div>

        <!-- 2. Utilisation des types de congés -->
        <div class="col-lg-6">
            <div class="report-section">
                <h3>
                    <span class="icon" style="background: #dcfce7; color: #10b981;">
                        <i class="bi bi-clipboard-data"></i>
                    </span>
                    Utilisation des types de congés (@Model.AnneeSelectionnee)
                </h3>
                @if (Model.UtilisationTypesConges.Any())
                {
                    @foreach (var type in Model.UtilisationTypesConges)
                    {
                        var colors = new[] { "#10b981", "#3b82f6", "#f59e0b", "#ef4444", "#8b5cf6" };
                        var colorIndex = Model.UtilisationTypesConges.IndexOf(type) % colors.Length;
                        <div class="progress-bar-container">
                            <div class="progress-label">
                                <span>@type.TypeConge</span>
                                <span><strong>@type.NombreDemandes</strong> demandes (@type.JoursTotaux jours)</span>
                            </div>
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: @type.Pourcentage%; background: @colors[colorIndex];"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <p>Aucune demande de congé cette année</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- 3. Périodes pic -->
    <div class="report-section">
        <h3>
            <span class="icon" style="background: #fef3c7; color: #f59e0b;">
                <i class="bi bi-graph-up"></i>
            </span>
            Périodes avec le plus de demandes (12 derniers mois)
        </h3>
        @if (Model.PeriodesPic.Any())
        {
            var maxDemandes = Model.PeriodesPic.Max(p => p.NombreDemandes);
            maxDemandes = maxDemandes > 0 ? maxDemandes : 1;
            <div class="chart-placeholder">
                @foreach (var periode in Model.PeriodesPic.OrderBy(p => p.Annee).ThenBy(p => p.Mois))
                {
                    var height = (int)((double)periode.NombreDemandes / maxDemandes * 150);
                    height = height < 10 ? 10 : height;
                    <div class="chart-bar @(periode.EstPeriodePic ? "highlight" : "")" 
                         style="height: @(height)px;" 
                         data-value="@periode.NomMois.Substring(0, 3)" 
                         title="@periode.NomMois @periode.Annee: @periode.NombreDemandes demandes">
                    </div>
                }
            </div>
            <div class="mt-3">
                <small class="text-muted">
                    <span class="badge badge-pic">Périodes pic</span> = mois avec le plus de demandes
                </small>
            </div>
        }
        else
        {
            <div class="empty-state">
                <p>Aucune donnée disponible</p>
            </div>
        }
    </div>

    <!-- 4. Tendances annuelles -->
    <div class="report-section">
        <h3>
            <span class="icon" style="background: #e0e7ff; color: #4f46e5;">
                <i class="bi bi-bar-chart-line"></i>
            </span>
            Tendances annuelles @Model.AnneeSelectionnee
        </h3>
        <div class="table-responsive">
            <table class="table-modern">
    <thead>
        <tr>
                        <th>Mois</th>
                        <th>Demandes</th>
                        <th>Jours de congés</th>
                        <th>Variation</th>
                        <th>Tendance</th>
        </tr>
    </thead>
    <tbody>
                    @foreach (var tendance in Model.TendancesAnnuelles)
                    {
                        <tr>
                            <td><strong>@tendance.NomMois</strong></td>
                            <td>@tendance.NombreDemandes</td>
                            <td>@tendance.JoursConges jours</td>
                            <td>
                                @if (tendance.VariationPourcentage > 0)
                                {
                                    <span style="color: #16a34a;">+@tendance.VariationPourcentage%</span>
                                }
                                else if (tendance.VariationPourcentage < 0)
                                {
                                    <span style="color: #dc2626;">@tendance.VariationPourcentage%</span>
                                }
                                else
                                {
                                    <span style="color: #64748b;">0%</span>
                                }
            </td>
            <td>
                                @if (tendance.Tendance == "hausse")
                                {
                                    <span class="badge badge-hausse">↑ Hausse</span>
                                }
                                else if (tendance.Tendance == "baisse")
                                {
                                    <span class="badge badge-baisse">↓ Baisse</span>
                                }
                                else
                                {
                                    <span class="badge badge-stable">→ Stable</span>
                                }
            </td>
        </tr>
}
    </tbody>
</table>
        </div>
    </div>

</div>
