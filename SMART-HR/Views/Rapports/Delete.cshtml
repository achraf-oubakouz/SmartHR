@model SmartHR.Models.Rapport

@{
    ViewData["Title"] = "Supprimer le Rapport";
}

<style>
    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        border: 1px solid #e2e8f0;
        background: white;
        color: #334155;
        border-radius: 0.5rem;
        text-decoration: none;
        margin-bottom: 1rem;
        transition: all 0.2s;
    }
    .btn-back:hover {
        background: #f8fafc;
        color: #1a1a2e;
    }
    .delete-card {
        background: white;
        border-radius: 1rem;
        padding: 2rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        max-width: 600px;
        border-top: 4px solid #ef4444;
    }
    .delete-card h1 {
        font-size: 1.5rem;
        font-weight: 700;
        color: #ef4444;
        margin-bottom: 0.5rem;
    }
    .delete-card .warning-text {
        color: #64748b;
        margin-bottom: 1.5rem;
    }
    .detail-row {
        display: flex;
        border-bottom: 1px solid #e2e8f0;
        padding: 0.75rem 0;
    }
    .detail-row:last-of-type {
        border-bottom: none;
    }
    .detail-label {
        width: 150px;
        font-weight: 600;
        color: #64748b;
        font-size: 0.875rem;
    }
    .detail-value {
        flex: 1;
        color: #334155;
    }
    .action-btns {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
    }
    .btn-delete {
        padding: 0.75rem 1.5rem;
        background: #ef4444;
        color: white;
        border: none;
        border-radius: 0.5rem;
        font-weight: 600;
        cursor: pointer;
    }
    .btn-delete:hover {
        background: #dc2626;
    }
    .btn-cancel {
        padding: 0.75rem 1.5rem;
        background: white;
        color: #64748b;
        border: 1px solid #e2e8f0;
        border-radius: 0.5rem;
        text-decoration: none;
        font-weight: 500;
    }
    .btn-cancel:hover {
        background: #f8fafc;
        color: #334155;
    }
</style>

<div class="container py-4">
    <a asp-action="Historique" class="btn-back">
        ← Retour à l'historique
    </a>

    <div class="delete-card">
        <h1>⚠️ Supprimer ce rapport ?</h1>
        <p class="warning-text">Cette action est irréversible. Toutes les données associées à ce rapport seront définitivement supprimées.</p>

        <div class="detail-row">
            <div class="detail-label">Titre</div>
            <div class="detail-value"><strong>@Model.Titre</strong></div>
        </div>

        <div class="detail-row">
            <div class="detail-label">Type</div>
            <div class="detail-value">@Model.Type</div>
        </div>

        <div class="detail-row">
            <div class="detail-label">Date</div>
            <div class="detail-value">@Model.DateGeneration.ToString("dd/MM/yyyy")</div>
        </div>

  
        <form asp-action="Delete" class="action-btns">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn-delete"> Confirmer la suppression</button>
            <a asp-action="Historique" class="btn-cancel">Annuler</a>
        </form>
    </div>
</div>
