@model SmartHR.Models.Rapport

@{
    ViewData["Title"] = "Générer un Rapport";
}

<style>
    .page-header {
        margin-bottom: 2rem;
    }
    .page-header h1 {
        font-size: 2rem;
        font-weight: 700;
        color: #1a1a2e;
    }
    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        border: 1px solid #e2e8f0;
        background: white;
        color: #334155;
        border-radius: 0.5rem;
        text-decoration: none;
        margin-bottom: 1rem;
        transition: all 0.2s;
    }
    .btn-back:hover {
        background: #f8fafc;
        color: #1a1a2e;
    }
    .form-card {
        background: white;
        border-radius: 1rem;
        padding: 2rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        max-width: 600px;
    }
    .form-group {
        margin-bottom: 1.5rem;
    }
    .form-label {
        display: block;
        font-weight: 600;
        color: #334155;
        margin-bottom: 0.5rem;
    }
    .form-control-custom {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 1px solid #e2e8f0;
        border-radius: 0.5rem;
        font-size: 1rem;
        transition: all 0.2s;
    }
    .form-control-custom:focus {
        outline: none;
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }
    .type-selector {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
    }
    .type-option {
        position: relative;
    }
    .type-option input {
        position: absolute;
        opacity: 0;
    }
    .type-option label {
        display: block;
        padding: 1rem;
        border: 2px solid #e2e8f0;
        border-radius: 0.75rem;
        cursor: pointer;
        transition: all 0.2s;
        text-align: center;
    }
    .type-option label:hover {
        border-color: #3b82f6;
        background: #f8fafc;
    }
    .type-option input:checked + label {
        border-color: #3b82f6;
        background: #dbeafe;
    }
    .type-option .type-icon {
        font-size: 1.5rem;
        display: block;
        margin-bottom: 0.5rem;
    }
    .type-option .type-name {
        font-weight: 600;
        color: #334155;
        font-size: 0.875rem;
    }
    .btn-submit {
        padding: 0.75rem 2rem;
        background: #1a1a2e;
        color: white;
        border: none;
        border-radius: 0.5rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }
    .btn-submit:hover {
        background: #16213e;
    }
    .btn-cancel {
        padding: 0.75rem 2rem;
        background: white;
        color: #64748b;
        border: 1px solid #e2e8f0;
        border-radius: 0.5rem;
        text-decoration: none;
        font-weight: 500;
        margin-left: 1rem;
    }
    .btn-cancel:hover {
        background: #f8fafc;
        color: #334155;
    }
</style>

<div class="container py-4">
    <a asp-action="Index" class="btn-back">
        ← Retour au Tableau de Bord
    </a>

    <div class="page-header">
        <h1>Générer un nouveau rapport</h1>
    </div>

    <div class="form-card">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group">
                <label class="form-label">Type de Rapport</label>
                <div class="type-selector">
                    <div class="type-option">
                        <input type="radio" name="Type" id="typeEmployes" value="EmployesParDepartement" checked>
                        <label for="typeEmployes">
                            <span class="type-icon"><i class="bi bi-people-fill"></i></span>
                            <span class="type-name">Employés par Département</span>
                        </label>
                    </div>
                    <div class="type-option">
                        <input type="radio" name="Type" id="typeConges" value="UtilisationConges">
                        <label for="typeConges">
                            <span class="type-icon"><i class="bi bi-clipboard-data"></i></span>
                            <span class="type-name">Utilisation des Congés</span>
                        </label>
                    </div>
                    <div class="type-option">
                        <input type="radio" name="Type" id="typePeriodes" value="PeriodesPic">
                        <label for="typePeriodes">
                            <span class="type-icon"><i class="bi bi-graph-up"></i></span>
                            <span class="type-name">Périodes de Pic</span>
                        </label>
                    </div>
                    <div class="type-option">
                        <input type="radio" name="Type" id="typeTendances" value="TendancesAnnuelles">
                        <label for="typeTendances">
                            <span class="type-icon"><i class="bi bi-bar-chart-line"></i></span>
                            <span class="type-name">Tendances Annuelles</span>
                        </label>
                    </div>
                    <div class="type-option">
                        <input type="radio" name="Type" id="typeComplet" value="RapportComplet">
                        <label for="typeComplet">
                            <span class="type-icon"><i class="bi bi-file-earmark-bar-graph"></i></span>
                            <span class="type-name">Rapport Complet</span>
                        </label>
                    </div>
                </div>
                <span asp-validation-for="Type" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Titre" class="form-label">Titre du Rapport</label>
                <input asp-for="Titre" class="form-control-custom" placeholder="Ex: Rapport mensuel - Décembre 2025" />
                <span asp-validation-for="Titre" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control-custom" rows="3" placeholder="Description du rapport..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn-submit">Générer le rapport</button>
                <a asp-action="Index" class="btn-cancel">Annuler</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
