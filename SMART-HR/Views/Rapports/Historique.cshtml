@model IEnumerable<SmartHR.Models.Rapport>

@{
    ViewData["Title"] = "Historique des Rapports";
}

<style>
    .page-header {
        margin-bottom: 2rem;
    }
    .page-header h1 {
        font-size: 2rem;
        font-weight: 700;
        color: #1a1a2e;
    }
    .page-header p {
        color: #64748b;
    }
    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        border: 1px solid #e2e8f0;
        background: white;
        color: #334155;
        border-radius: 0.5rem;
        text-decoration: none;
        margin-bottom: 1rem;
        transition: all 0.2s;
    }
    .btn-back:hover {
        background: #f8fafc;
        color: #1a1a2e;
    }
    .reports-table {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }
    .reports-table table {
        width: 100%;
        border-collapse: collapse;
    }
    .reports-table th {
        background: #f8fafc;
        padding: 1rem;
        text-align: left;
        font-weight: 600;
        color: #475569;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 1px solid #e2e8f0;
    }
    .reports-table td {
        padding: 1rem;
        border-bottom: 1px solid #e2e8f0;
        color: #334155;
    }
    .reports-table tr:hover td {
        background: #f8fafc;
    }
    .report-type {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        background: #e0e7ff;
        color: #4f46e5;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 500;
    }
    .action-btns {
        display: flex;
        gap: 0.5rem;
    }
    .action-btn {
        padding: 0.375rem 0.75rem;
        border-radius: 0.375rem;
        font-size: 0.75rem;
        text-decoration: none;
        transition: all 0.2s;
    }
    .action-btn.view { background: #dbeafe; color: #1d4ed8; }
    .action-btn.edit { background: #fef3c7; color: #d97706; }
    .action-btn.delete { background: #fee2e2; color: #dc2626; }
    .action-btn:hover { opacity: 0.8; }
    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        color: #64748b;
    }
    .empty-state h3 {
        color: #334155;
        margin-bottom: 0.5rem;
    }
    .btn-create {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        background: #1a1a2e;
        color: white;
        border-radius: 0.5rem;
        text-decoration: none;
        font-weight: 500;
        margin-top: 1rem;
        transition: all 0.2s;
    }
    .btn-create:hover {
        background: #16213e;
        color: white;
    }
</style>

<div class="container py-4">
    <a asp-action="Index" class="btn-back">
        ← Retour au Tableau de Bord
    </a>

    <div class="page-header">
        <h1>Historique des rapports</h1>
        <p>Consultez et gérez les rapports générés.</p>
    </div>

    <div class="reports-table">
        @if (Model.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Titre</th>
                        <th>Type</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.DateGeneration.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><strong>@item.Titre</strong></td>
                            <td><span class="report-type">@item.Type</span></td>
                            <td>@(item.Description?.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)</td>
                            <td>
                                <div class="action-btns">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="action-btn view">Voir</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn edit">Modifier</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="action-btn delete">Supprimer</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <h3>Aucun rapport sauvegardé</h3>
                <p>Créez votre premier rapport pour commencer à suivre vos données RH.</p>
                <a asp-action="Create" class="btn-create">
                    Créer un rapport
                </a>
            </div>
        }
    </div>

    @if (Model.Any())
    {
        <div class="mt-4">
            <a asp-action="Create" class="btn-create">
                Nouveau rapport
            </a>
        </div>
    }
</div>

