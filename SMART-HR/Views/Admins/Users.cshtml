@model IEnumerable<SmartHR.ViewModels.UserListItemViewModel>
@{
    ViewData["Title"] = "Gestion des Utilisateurs";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1><i class="bi bi-people"></i> Gestion des Utilisateurs</h1>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
                            <li class="breadcrumb-item active">Utilisateurs</li>
                        </ol>
                    </nav>
                </div>
                <a asp-action="CreateUser" class="btn btn-success btn-lg">
                    <i class="bi bi-person-plus"></i> Créer un utilisateur
                </a>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search and Filter -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-funnel"></i> Recherche et Filtres</h5>
        </div>
        <div class="card-body">
            <form method="get" asp-action="Users">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label for="searchTerm" class="form-label">Rechercher</label>
                        <input type="text" class="form-control" id="searchTerm" name="searchTerm" 
                               value="@ViewBag.SearchTerm" placeholder="Nom, prénom, email...">
                    </div>
                    <div class="col-md-3">
                        <label for="roleFilter" class="form-label">Rôle</label>
                        <select class="form-select" id="roleFilter" name="roleFilter">
                            <option value="">Tous les rôles</option>
                            <option value="Admin" selected="@(ViewBag.RoleFilter == "Admin")">Admin</option>
                            <option value="RH" selected="@(ViewBag.RoleFilter == "RH")">RH</option>
                            <option value="Manager" selected="@(ViewBag.RoleFilter == "Manager")">Manager</option>
                            <option value="Employe" selected="@(ViewBag.RoleFilter == "Employe")">Employé</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="activeFilter" class="form-label">Statut</label>
                        <select class="form-select" id="activeFilter" name="activeFilter">
                            <option value="">Tous les statuts</option>
                            <option value="true" selected="@(ViewBag.ActiveFilter == true)">Actif</option>
                            <option value="false" selected="@(ViewBag.ActiveFilter == false)">Inactif</option>
                        </select>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search"></i> Filtrer
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Users Table -->
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-table"></i> Liste des Utilisateurs (@Model.Count())</h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Nom complet</th>
                                <th>Email</th>
                                <th>Rôle</th>
                                <th>Statut</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@user.FullName</strong>
                                    </td>
                                    <td>@user.Email</td>
                                    <td>
                                        <span class="@user.RoleBadgeClass">@user.Role</span>
                                    </td>
                                    <td>
                                        <span class="@user.StatusClass">@user.Status</span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="UserDetails" asp-route-id="@user.Id" 
                                               class="btn btn-sm btn-info" title="Détails">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="EditUser" asp-route-id="@user.Id" 
                                               class="btn btn-sm btn-warning" title="Modifier">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="ResetPassword" asp-route-id="@user.Id" 
                                               class="btn btn-sm btn-secondary" title="Réinitialiser le mot de passe">
                                                <i class="bi bi-key"></i>
                                            </a>
                                            <form asp-action="ToggleActive" asp-route-id="@user.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" 
                                                        class="btn btn-sm @(user.Actif ? "btn-danger" : "btn-success")" 
                                                        title="@(user.Actif ? "Désactiver" : "Activer")"
                                                        onclick="return confirm('Êtes-vous sûr de vouloir @(user.Actif ? "désactiver" : "activer") cet utilisateur ?');">
                                                    <i class="bi bi-@(user.Actif ? "x-circle" : "check-circle")"></i>
                                                </button>
                                            </form>
                                            <a asp-action="DeleteUser" asp-route-id="@user.Id" 
                                               class="btn btn-sm btn-danger" title="Supprimer">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox" style="font-size: 4rem; color: #ccc;"></i>
                    <p class="text-muted mt-3">Aucun utilisateur trouvé</p>
                    @if (!string.IsNullOrEmpty(ViewBag.SearchTerm) || !string.IsNullOrEmpty(ViewBag.RoleFilter) || ViewBag.ActiveFilter != null)
                    {
                        <a asp-action="Users" class="btn btn-primary">Réinitialiser les filtres</a>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
    .btn-group .btn {
        margin: 0 2px;
    }
    
    .table td {
        vertical-align: middle;
    }

    .badge {
        font-size: 0.85rem;
        padding: 0.35em 0.65em;
    }
</style>

