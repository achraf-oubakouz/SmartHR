@model SmartHR.ViewModels.EditUserViewModel
@{
    ViewData["Title"] = "Modifier l'Utilisateur";
}

<div class="container">
    <div class="row mb-4">
        <div class="col-12">
            <h1><i class="bi bi-pencil"></i> Modifier l'Utilisateur</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Users">Utilisateurs</a></li>
                    <li class="breadcrumb-item active">Modifier</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-warning">
            <h5 class="mb-0"><i class="bi bi-pencil-fill"></i> Modification des informations</h5>
        </div>
        <div class="card-body">
            <form asp-action="EditUser" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <!-- Basic Information -->
                <h5 class="mb-3"><i class="bi bi-person"></i> Informations de base</h5>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Prenom" class="form-label"></label>
                        <input asp-for="Prenom" class="form-control" />
                        <span asp-validation-for="Prenom" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Nom" class="form-label"></label>
                        <input asp-for="Nom" class="form-control" />
                        <span asp-validation-for="Nom" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Role" class="form-label"></label>
                        <select asp-for="Role" class="form-select" id="roleSelect">
                            <option value="Admin">Admin - Accès complet</option>
                            <option value="RH">RH - Ressources Humaines</option>
                            <option value="Manager">Manager - Responsable d'équipe</option>
                            <option value="Employe">Employé - Utilisateur standard</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input asp-for="Actif" class="form-check-input" type="checkbox" />
                            <label asp-for="Actif" class="form-check-label"></label>
                        </div>
                    </div>
                </div>

                <hr />

                <!-- Role-Specific Information -->
                <h5 class="mb-3"><i class="bi bi-briefcase"></i> Informations professionnelles</h5>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Departement" class="form-label"></label>
                        <input asp-for="Departement" class="form-control" />
                        <span asp-validation-for="Departement" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Poste" class="form-label"></label>
                        <input asp-for="Poste" class="form-control" />
                        <span asp-validation-for="Poste" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Telephone" class="form-label"></label>
                        <input asp-for="Telephone" class="form-control" />
                        <span asp-validation-for="Telephone" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EmailProfessionnel" class="form-label"></label>
                        <input asp-for="EmailProfessionnel" class="form-control" />
                        <span asp-validation-for="EmailProfessionnel" class="text-danger"></span>
                    </div>
                </div>

                <!-- Manager Assignment (only for Employe role) -->
                <div class="row mb-3" id="managerSection" style="display: none;">
                    <div class="col-md-6">
                        <label asp-for="ManagerId" class="form-label"></label>
                        <select asp-for="ManagerId" class="form-select" asp-items="ViewBag.Managers">
                            <option value="">-- Aucun manager --</option>
                        </select>
                        <span asp-validation-for="ManagerId" class="text-danger"></span>
                    </div>
                </div>

                <hr />

                <!-- Actions -->
                <div class="d-flex justify-content-between">
                    <a asp-action="Users" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Annuler
                    </a>
                    <button type="submit" class="btn btn-warning btn-lg">
                        <i class="bi bi-check-circle"></i> Enregistrer les modifications
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="card mt-3">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-lightning-fill"></i> Actions rapides</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <a asp-action="ResetPassword" asp-route-id="@Model.Id" class="btn btn-secondary w-100">
                        <i class="bi bi-key"></i> Réinitialiser le mot de passe
                    </a>
                </div>
                <div class="col-md-4">
                    <form asp-action="ToggleActive" asp-route-id="@Model.Id" method="post" class="d-inline w-100">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn @(Model.Actif ? "btn-danger" : "btn-success") w-100">
                            <i class="bi bi-@(Model.Actif ? "x-circle" : "check-circle")"></i> 
                            @(Model.Actif ? "Désactiver" : "Activer") le compte
                        </button>
                    </form>
                </div>
                <div class="col-md-4">
                    <a asp-action="DeleteUser" asp-route-id="@Model.Id" class="btn btn-danger w-100">
                        <i class="bi bi-trash"></i> Supprimer l'utilisateur
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            // Show/hide manager section based on role
            function toggleManagerSection() {
                if ($('#roleSelect').val() === 'Employe') {
                    $('#managerSection').show();
                } else {
                    $('#managerSection').hide();
                }
            }

            $('#roleSelect').change(toggleManagerSection);
            
            // Trigger on page load
            toggleManagerSection();
        });
    </script>
}

<style>
    .card {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    .form-label {
        font-weight: 600;
        color: #495057;
    }

    .form-control:focus, .form-select:focus {
        border-color: #ffc107;
        box-shadow: 0 0 0 0.2rem rgba(255, 193, 7, 0.25);
    }

    hr {
        margin: 2rem 0;
        border-top: 2px solid #dee2e6;
    }
</style>

