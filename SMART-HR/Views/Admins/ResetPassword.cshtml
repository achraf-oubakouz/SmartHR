@model SmartHR.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Réinitialiser le Mot de Passe";
}

<div class="container">
    <div class="row mb-4">
        <div class="col-12">
            <h1><i class="bi bi-key"></i> Réinitialiser le Mot de Passe</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Users">Utilisateurs</a></li>
                    <li class="breadcrumb-item active">Réinitialiser le mot de passe</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="bi bi-key-fill"></i> Nouveau mot de passe pour l'utilisateur</h5>
                </div>
                <div class="card-body">
                    <!-- User Info -->
                    <div class="alert alert-info">
                        <h6><i class="bi bi-info-circle"></i> Utilisateur concerné</h6>
                        <p class="mb-0">
                            <strong>Nom:</strong> @Model.UserName<br />
                            <strong>Email:</strong> @Model.Email
                        </p>
                    </div>

                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i> 
                        <strong>Attention:</strong> Cette action réinitialisera le mot de passe de l'utilisateur. 
                        Assurez-vous de lui communiquer le nouveau mot de passe de manière sécurisée.
                    </div>

                    <form asp-action="ResetPassword" method="post">
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="UserName" />
                        <input type="hidden" asp-for="Email" />
                        
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label"></label>
                            <input asp-for="NewPassword" class="form-control" placeholder="Minimum 6 caractères" />
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                            <div class="form-text">
                                <i class="bi bi-shield-check"></i> Le mot de passe doit contenir au moins 6 caractères.
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirmez le mot de passe" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">
                            <a asp-action="Users" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Annuler
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle"></i> Réinitialiser le mot de passe
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Tips Card -->
            <div class="card mt-3">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-lightbulb"></i> Conseils de sécurité</h6>
                </div>
                <div class="card-body">
                    <ul class="mb-0">
                        <li>Utilisez un mot de passe temporaire et demandez à l'utilisateur de le changer à la première connexion</li>
                        <li>Ne partagez jamais le mot de passe par email non sécurisé</li>
                        <li>Assurez-vous que le mot de passe contient un mélange de lettres, chiffres et caractères spéciaux</li>
                        <li>Évitez d'utiliser des informations personnelles facilement devinables</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            // Show password strength indicator
            $('#NewPassword').on('input', function () {
                var password = $(this).val();
                var strength = 0;
                
                if (password.length >= 6) strength++;
                if (password.length >= 10) strength++;
                if (/[a-z]/.test(password) && /[A-Z]/.test(password)) strength++;
                if (/\d/.test(password)) strength++;
                if (/[^a-zA-Z\d]/.test(password)) strength++;
                
                var strengthText = '';
                var strengthClass = '';
                
                if (strength < 2) {
                    strengthText = 'Faible';
                    strengthClass = 'text-danger';
                } else if (strength < 4) {
                    strengthText = 'Moyen';
                    strengthClass = 'text-warning';
                } else {
                    strengthText = 'Fort';
                    strengthClass = 'text-success';
                }
                
                // You can add a strength indicator here if needed
            });
        });
    </script>
}

<style>
    .card {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    .form-label {
        font-weight: 600;
        color: #495057;
    }

    .form-control:focus {
        border-color: #6c757d;
        box-shadow: 0 0 0 0.2rem rgba(108, 117, 125, 0.25);
    }

    .alert {
        border-radius: 0.5rem;
    }
</style>

