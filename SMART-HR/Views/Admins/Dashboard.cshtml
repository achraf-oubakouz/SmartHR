@model SmartHR.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Tableau de bord Admin";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-4">
                <i class="bi bi-speedometer2"></i> Tableau de bord Administrateur
            </h1>
            <p class="lead">Centre de contrôle du système SMART-HR</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-uppercase mb-0">Total Utilisateurs</h6>
                            <h2 class="mb-0">@Model.TotalUsers</h2>
                        </div>
                        <i class="bi bi-people-fill" style="font-size: 3rem; opacity: 0.5;"></i>
                    </div>
                    <small>@Model.ActiveUsers actifs / @Model.InactiveUsers inactifs</small>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card text-white bg-danger">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-uppercase mb-0">Administrateurs</h6>
                            <h2 class="mb-0">@Model.AdminCount</h2>
                        </div>
                        <i class="bi bi-shield-fill-check" style="font-size: 3rem; opacity: 0.5;"></i>
                    </div>
                    <small>Accès complet</small>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-uppercase mb-0">RH</h6>
                            <h2 class="mb-0">@Model.HRCount</h2>
                        </div>
                        <i class="bi bi-person-badge-fill" style="font-size: 3rem; opacity: 0.5;"></i>
                    </div>
                    <small>Ressources Humaines</small>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-uppercase mb-0">Managers</h6>
                            <h2 class="mb-0">@Model.ManagerCount</h2>
                        </div>
                        <i class="bi bi-person-workspace" style="font-size: 3rem; opacity: 0.5;"></i>
                    </div>
                    <small>Responsables d'équipe</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-uppercase mb-0">Employés</h6>
                            <h2 class="mb-0">@Model.EmployeeCount</h2>
                        </div>
                        <i class="bi bi-person-fill" style="font-size: 3rem; opacity: 0.5;"></i>
                    </div>
                    <small>Personnel général</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0"><i class="bi bi-lightning-fill"></i> Actions rapides</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <a asp-action="Users" class="btn btn-lg btn-primary w-100">
                                <i class="bi bi-people"></i><br />
                                Gérer les utilisateurs
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a asp-action="CreateUser" class="btn btn-lg btn-success w-100">
                                <i class="bi bi-person-plus"></i><br />
                                Créer un utilisateur
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a asp-controller="Calendriers" asp-action="Index" class="btn btn-lg btn-info w-100">
                                <i class="bi bi-calendar3"></i><br />
                                Calendrier
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a asp-action="Settings" class="btn btn-lg btn-secondary w-100">
                                <i class="bi bi-gear"></i><br />
                                Paramètres
                            </a>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <a asp-controller="DemandeConges" asp-action="Index" class="btn btn-lg btn-warning w-100">
                                <i class="bi bi-calendar-check"></i><br />
                                Demandes de congé
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a asp-controller="Rapports" asp-action="Index" class="btn btn-lg btn-primary w-100">
                                <i class="bi bi-file-earmark-text"></i><br />
                                Rapports
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a asp-controller="Documents" asp-action="Index" class="btn btn-lg btn-success w-100">
                                <i class="bi bi-file-earmark-pdf"></i><br />
                                Documents
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a asp-controller="Employes" asp-action="Index" class="btn btn-lg btn-info w-100">
                                <i class="bi bi-person-lines-fill"></i><br />
                                Employés
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Users -->
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-clock-history"></i> Utilisateurs récents</h5>
                </div>
                <div class="card-body">
                    @if (Model.RecentUsers.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var user in Model.RecentUsers)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-0">@user.FullName</h6>
                                        <small class="text-muted">@user.Email</small>
                                    </div>
                                    <div>
                                        <span class="@user.RoleBadgeClass me-1">@user.Role</span>
                                        <span class="@user.StatusClass">@user.Status</span>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="text-center mt-3">
                            <a asp-action="Users" class="btn btn-sm btn-outline-primary">Voir tous les utilisateurs</a>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center mb-0">Aucun utilisateur</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-info-circle"></i> Informations système</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between">
                            <strong>Version système:</strong>
                            <span>SMART-HR v1.0</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <strong>Base de données:</strong>
                            <span class="badge bg-success">Connectée</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <strong>Statut:</strong>
                            <span class="badge bg-success">Opérationnel</span>
                        </li>
                        <li class="list-group-item">
                            <strong>Accès rapides:</strong>
                            <div class="mt-2">
                                <a asp-controller="Managers" asp-action="Index" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-person-workspace"></i> Managers
                                </a>
                                <a asp-controller="Admins" asp-action="Index" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-shield"></i> Admins
                                </a>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        border-radius: 0.5rem;
        margin-bottom: 1rem;
    }

    .card-body {
        padding: 1.5rem;
    }

    .bg-primary { background-color: #0d6efd !important; }
    .bg-danger { background-color: #dc3545 !important; }
    .bg-success { background-color: #198754 !important; }
    .bg-warning { background-color: #ffc107 !important; color: #000 !important; }
    .bg-info { background-color: #0dcaf0 !important; color: #000 !important; }
</style>

