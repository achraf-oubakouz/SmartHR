@model SmartHR.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard Admin";
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" />

<div class="admin-dashboard-pro">
    <div class="dashboard-container">
        <!-- Header -->
        <div class="dashboard-header">
            <div class="header-content">
                <div class="header-left">
                    <h1>Administration</h1>
                    <p>Vue d'ensemble de votre système</p>
                </div>
                <div class="header-right">
                    <a asp-action="Users" class="btn-primary-pro">
                        <i class="bi bi-people"></i> Gérer les utilisateurs
                    </a>
                </div>
            </div>
        </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

        <!-- Statistics Grid -->
        <div class="stats-grid">
            <div class="stat-item">
                <div class="stat-meta">
                    <span class="stat-label">Total Utilisateurs</span>
                    <span class="stat-trend">+12% ce mois</span>
                </div>
                <div class="stat-value">@Model.TotalUsers</div>
                <div class="stat-progress">
                    <div class="progress-bar" style="width: @(Model.TotalUsers > 0 ? (double)Model.ActiveUsers / Model.TotalUsers * 100 : 0)%"></div>
                </div>
                <div class="stat-footer">
                    <span class="text-success">@Model.ActiveUsers actifs</span>
                    <span class="text-muted">@Model.InactiveUsers inactifs</span>
                </div>
            </div>

            <div class="stat-item">
                <div class="stat-meta">
                    <span class="stat-label">Administrateurs</span>
                    <span class="stat-badge admin">Admin</span>
                </div>
                <div class="stat-value">@Model.AdminCount</div>
                <div class="stat-footer">
                    <span class="text-muted">Accès complet au système</span>
                </div>
            </div>

            <div class="stat-item">
                <div class="stat-meta">
                    <span class="stat-label">Ressources Humaines</span>
                    <span class="stat-badge rh">RH</span>
                </div>
                <div class="stat-value">@Model.HRCount</div>
                <div class="stat-footer">
                    <span class="text-muted">Gestion du personnel</span>
                </div>
            </div>

            <div class="stat-item">
                <div class="stat-meta">
                    <span class="stat-label">Managers</span>
                    <span class="stat-badge manager">Manager</span>
                </div>
                <div class="stat-value">@Model.ManagerCount</div>
                <div class="stat-footer">
                    <span class="text-muted">Supervision d'équipe</span>
                </div>
            </div>

            <div class="stat-item">
                <div class="stat-meta">
                    <span class="stat-label">Employés</span>
                    <span class="stat-badge employee">Staff</span>
                </div>
                <div class="stat-value">@Model.EmployeeCount</div>
                <div class="stat-footer">
                    <span class="text-muted">Personnel général</span>
                </div>
            </div>
        </div>

        <!-- Main Content Grid -->
        <div class="content-grid">
            <!-- Recent Users -->
            <div class="content-section users-section">
                <div class="section-header-pro">
                    <h3>Utilisateurs Récents</h3>
                    <a asp-action="Users" class="link-pro">Voir tout →</a>
                </div>
                <div class="users-table">
                    @if (Model.RecentUsers.Any())
                    {
                        @foreach (var user in Model.RecentUsers)
                        {
                            var initials = string.Join("", user.FullName.Split(' ').Select(n => n.Substring(0, 1)).Take(2));
                            <div class="user-row">
                                <div class="user-info-pro">
                                    <div class="user-avatar-pro">@initials</div>
                                    <div class="user-details-pro">
                                        <div class="user-name-pro">@user.FullName</div>
                                        <div class="user-email-pro">@user.Email</div>
                                    </div>
                                </div>
                                <div class="user-meta-pro">
                                    <span class="role-badge-@user.Role.ToLower()">@user.Role</span>
                                    @if (user.Actif)
                                    {
                                        <span class="status-active">●</span>
                                    }
                                    else
                                    {
                                        <span class="status-inactive">●</span>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state-pro">
                            <p>Aucun utilisateur récent</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Quick Links -->
            <div class="content-section links-section">
                <div class="section-header-pro">
                    <h3>Accès Rapide</h3>
                </div>
                <nav class="quick-nav">
                    <a asp-action="CreateUser" class="nav-item-pro">
                        <i class="bi bi-person-plus"></i>
                        <span>Nouvel utilisateur</span>
                    </a>
                    <a asp-controller="Calendriers" asp-action="Index" class="nav-item-pro">
                        <i class="bi bi-calendar3"></i>
                        <span>Calendrier</span>
                    </a>
                    <a asp-controller="DemandeConges" asp-action="Index" class="nav-item-pro">
                        <i class="bi bi-calendar-check"></i>
                        <span>Congés</span>
                    </a>
                    <a asp-controller="Rapports" asp-action="Index" class="nav-item-pro">
                        <i class="bi bi-graph-up"></i>
                        <span>Rapports</span>
                    </a>
                    <a asp-controller="Documents" asp-action="Index" class="nav-item-pro">
                        <i class="bi bi-file-text"></i>
                        <span>Documents</span>
                    </a>
                    <a asp-action="Settings" class="nav-item-pro">
                        <i class="bi bi-gear"></i>
                        <span>Paramètres</span>
                    </a>
                </nav>
            </div>
        </div>

        <!-- System Info -->
        <div class="system-info">
            <div class="info-items">
                <div class="info-pill">
                    <span class="label">Version</span>
                    <span class="value">1.0</span>
                </div>
                <div class="info-pill">
                    <span class="label">Database</span>
                    <span class="value status-dot">● En ligne</span>
                </div>
                <div class="info-pill">
                    <span class="label">Système</span>
                    <span class="value status-dot">● Opérationnel</span>
                </div>
            </div>
        </div>
    </div>
</div>
